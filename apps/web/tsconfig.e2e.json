{
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.d.ts",
    "../../packages/client/*/src/css-modules.d.ts"
  ],
  "exclude": [
    "tests/**/*.expected.ts",
    "tests/**/*.expected.e2e.ts"
  ]
}
