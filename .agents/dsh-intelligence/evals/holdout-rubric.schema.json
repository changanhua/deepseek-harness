{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-intelligence/evals/holdout-rubric.schema.json",
  "title": "Holdout Task Rubric",
  "description": "私有 holdout 任务的 Evaluator 可见面：不可见判卷标准，绝不进入模型输入。`additionalProperties:false` 禁止判卷标准以外的字段。",
  "type": "object",
  "required": ["id", "category", "rubric"],
  "properties": {
    "id": { "type": "string", "pattern": "^holdout-\\d{3}$" },
    "category": {
      "type": "string",
      "enum": [
        "seam-placement",
        "state-ownership-durability",
        "model-visible-event",
        "settings-vs-domain",
        "preset-vs-global",
        "compose-vs-invent",
        "repo-tool-vs-plugin"
      ]
    },
    "rubric": {
      "description": "Evaluator 可见面：不可见判卷标准。",
      "type": "object",
      "required": ["blocking_findings", "expected_properties", "forbidden_patterns"],
      "properties": {
        "blocking_findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "severity", "rule_id", "condition"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "rule_id": { "type": "string" },
              "condition": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "expected_properties": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array", "items": { "type": "string" } },
        "severity_weights": {
          "type": "object",
          "properties": {
            "P0": { "type": "integer", "minimum": 0 },
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
