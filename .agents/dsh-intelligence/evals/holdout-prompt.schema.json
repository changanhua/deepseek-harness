{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-intelligence/evals/holdout-prompt.schema.json",
  "title": "Holdout Task Prompt",
  "description": "私有 holdout 任务的模型可见面，只含需求与约束。`additionalProperties:false` 从结构上禁止把 expected_design / baseline_trap 等答案字段混入模型输入。",
  "type": "object",
  "required": ["id", "category", "prompt"],
  "properties": {
    "id": { "type": "string", "pattern": "^holdout-\\d{3}$" },
    "category": {
      "type": "string",
      "enum": [
        "seam-placement",
        "state-ownership-durability",
        "model-visible-event",
        "settings-vs-domain",
        "preset-vs-global",
        "compose-vs-invent",
        "repo-tool-vs-plugin"
      ]
    },
    "prompt": {
      "description": "模型可见面：只含需求与约束，绝不含答案。",
      "type": "object",
      "required": ["requirement", "constraints"],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
