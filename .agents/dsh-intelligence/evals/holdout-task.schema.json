{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-intelligence/evals/holdout-task.schema.json",
  "title": "Holdout Task (prompt/rubric split)",
  "description": "私有 holdout 任务。prompt 与 rubric 物理分离：模型只能读到 `prompt` 面；Evaluator 只能读 `rubric` 面。`additionalProperties:false` 从 schema 层禁止把 expected_design / baseline_trap 等答案混进 prompt。",
  "type": "object",
  "required": ["id", "category", "prompt", "rubric"],
  "properties": {
    "id": { "type": "string", "pattern": "^holdout-\\d{3}$" },
    "category": {
      "type": "string",
      "enum": [
        "seam-placement",
        "state-ownership-durability",
        "model-visible-event",
        "settings-vs-domain",
        "preset-vs-global",
        "compose-vs-invent",
        "repo-tool-vs-plugin"
      ]
    },
    "prompt": {
      "description": "模型可见面：只含需求与约束，绝不含答案。",
      "type": "object",
      "required": ["requirement", "constraints"],
      "properties": {
        "requirement": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "rubric": {
      "description": "Evaluator 可见面：不可见判卷标准，绝不进入模型输入。",
      "type": "object",
      "required": ["blocking_findings", "expected_properties", "forbidden_patterns"],
      "properties": {
        "blocking_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "rule_id", "condition"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "rule_id": { "type": "string" },
              "condition": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "expected_properties": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array", "items": { "type": "string" } },
        "severity_weights": {
          "type": "object",
          "properties": {
            "P0": { "type": "integer", "minimum": 0 },
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
