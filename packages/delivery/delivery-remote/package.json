    "@changanhua/dsh-delivery-testkit": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@changanhua/dsh-repo-workspace": "workspace:^",
    "@changanhua/dsh-task-queue": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
