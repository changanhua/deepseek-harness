    "cordis.patch.yml",
    "delivery.patch.yml",
    "skills",
    "lib/types/**/*.d.ts",
    "knowledge.patch.yml",
    "memory.patch.yml",
    "initiative.patch.yml"
  ],
  "license": "MIT",
  "private": true,
