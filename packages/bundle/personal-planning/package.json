{
  "name": "@changanhua/dsh-personal-planning",
  "description": "Optional personal planning bundle for durable project boards, model tools, browser Remote, and planning UI",
  "version": "0.1.2-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changanhua/deepseek-harness.git",
    "directory": "packages/bundle/personal-planning"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./delivery.patch.yml": "./delivery.patch.yml",
    "./src/*": "./src/*",
