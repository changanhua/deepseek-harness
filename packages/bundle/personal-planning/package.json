    "@changanhua/dsh-command-memory": "workspace:^",
    "@changanhua/dsh-initiative-local": "workspace:^",
    "@changanhua/dsh-command-initiative": "workspace:^",
    "@changanhua/dsh-tool-initiative": "workspace:^"
