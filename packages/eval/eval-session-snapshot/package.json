{
  "name": "@changanhua/dsh-eval-session-snapshot",
  "description": "Keyless ACP session-snapshot executor for deterministic DSH Eval suites",
  "version": "0.1.2-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changanhua/deepseek-harness.git",
    "directory": "packages/eval/eval-session-snapshot"
  },
  "type": "module",
  "main": "lib/index.js",
