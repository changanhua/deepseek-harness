    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": { "@modelcontextprotocol/sdk": "^1.12.0", "ws": "^8.18.3", "zod": "^4.4.3" },
  "devDependencies": { "@types/ws": "^8.18.1", "playwright": "^1.49.0" }
}
