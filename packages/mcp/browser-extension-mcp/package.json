{
  "name": "@changanhua/browser-extension-mcp",
  "version": "0.3.1",
  "description": "Independent local browser extension connector for MCP clients",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
